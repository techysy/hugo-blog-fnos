#!/bin/bash
set -uo pipefail

APP_NAME="${TRIM_APPNAME:-hugo-blog}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
# 数据目录用 fnOS 注入的 TRIM_PKGVAR (天然 = /vol4/@appdata/<app>, app 私有)。
# 文章/博客源放 app 私有目录，通过管理面板 API 管理，不暴露在公开 share。
DATA_DIR="${TRIM_PKGVAR:-/vol4/@appdata/${APP_NAME}}"
PORT="${TRIM_SERVICE_PORT:-13133}"
MGMT_PORT=13134
LOG="${DATA_DIR}/hugo.log"
PID_FILE="${DATA_DIR}/hugo.pid"
MGMT_PID_FILE="${DATA_DIR}/manager.pid"
MGMT_LOG="${DATA_DIR}/manager.log"

# Hugo Modules 环境: 支持 module 依赖主题 (如 docuapi)
# go 环境在 SRC_DIR 确定后配置 (见下方)
# 诊断日志（便于排查 fnOS 调用方式）
DIAG="${DATA_DIR}/hugo-diag.log"
mkdir -p "${DATA_DIR}" 2>/dev/null
{
    echo "=== $(date '+%F %T') call: '${1:-<none>}' USER=$(id -un) UID=$(id -u) ==="
    echo "  TRIM_APPDEST=${TRIM_APPDEST:-<unset>}"
    echo "  TRIM_PKGVAR=${TRIM_PKGVAR:-<unset>}"
    echo "  APP_DIR=${APP_DIR}"
    echo "  DATA_DIR=${DATA_DIR}"
} >> "${DIAG}" 2>&1

# 定位安装目录（兼容 /var/apps 与 /vol4/@appcenter 布局）
if [ -d "${APP_DIR}/server" ]; then
    SRC_DIR="${APP_DIR}/server"
elif [ -d "${APP_DIR}/target/server" ]; then
    SRC_DIR="${APP_DIR}/target/server"
else
    echo "ERROR: server dir not found (APP_DIR=${APP_DIR})" >&2
    exit 1
fi

# Hugo 二进制
HUGO_BIN="${SRC_DIR}/hugo"
if [ ! -x "${HUGO_BIN}" ]; then
    HUGO_BIN="$(command -v hugo || echo /usr/local/bin/hugo)"
fi

# Hugo Modules 环境: 支持 module 依赖主题 (如 docuapi)
# 依赖飞牛官方 go 依赖 (manifest install_dep_apps=go-1.26)
GO_DIR=""
for c in "/vol4/@appcenter/go-1.26" "/var/apps/go-1.26"; do
    if [ -x "${c}/bin/go" ]; then
        GO_DIR="${c}"
        break
    fi
done
if [ -n "${GO_DIR}" ]; then
    export GOROOT="${GO_DIR}"
    export PATH="${GO_DIR}/bin:${PATH}"
    echo "  go: ${GO_DIR}" >> "${DIAG}" 2>&1
fi
export HUGO_MODULE_CACHE="${DATA_DIR}/.hugo_modules"
export GOPROXY="https://goproxy.cn,direct"
export GONOSUMDB="*"
export GONOSUMCHECK=1
export GOFLAGS="-mod=mod"

# 博客源数据目录（content/config/themes 等）
BLOG_DIR="${DATA_DIR}/blog"
TEMPLATE_DIR="${SRC_DIR}/template"

ensure_blog_dir() {
    if [ ! -f "${BLOG_DIR}/config.toml" ] && [ ! -d "${BLOG_DIR}/config" ]; then
        echo "  init blog dir from template" >> "${DIAG}" 2>&1
        mkdir -p "${BLOG_DIR}"
        cp -r "${TEMPLATE_DIR}/." "${BLOG_DIR}/"
        # hugo 需要写 public/，确保权限
        chmod -R u+rwX "${BLOG_DIR}" 2>/dev/null || true
    fi
    echo "  BLOG_DIR=${BLOG_DIR}" >> "${DIAG}" 2>&1
}

start() {
    echo "  start() begin, port=${PORT}" >> "${DIAG}" 2>&1
    mkdir -p "${DATA_DIR}" 2>/dev/null
    if [ -f "${PID_FILE}" ] && kill -0 "$(cat "${PID_FILE}")" 2>/dev/null; then
        echo "already running (pid $(cat "${PID_FILE}"))"; return 0
    fi
    ensure_blog_dir
    # 清理残留进程
    pkill -f "hugo server.*${BLOG_DIR}" 2>/dev/null || true
    sleep 1
    if ss -tln 2>/dev/null | grep -q ":${PORT} "; then
        echo "port ${PORT} busy" >> "${DIAG}" 2>&1
        echo "ERROR: port ${PORT} already in use" >&2
        return 1
    fi
    cd "${BLOG_DIR}"
    # 清理残留的 hugo build lock + public 渲染产物
    # （可能属主不对导致 hugo-blog 无法写，如 SSH 手动测试时用其它用户创建）
    rm -f "${BLOG_DIR}/.hugo_build.lock"
    rm -rf "${BLOG_DIR}/public"
    setsid "${HUGO_BIN}" server \
        --source "${BLOG_DIR}" \
        --bind 0.0.0.0 -p "${PORT}" \
        --buildDrafts --disableFastRender --ignoreCache \
        >> "${LOG}" 2>&1 &
    echo $! > "${PID_FILE}"
    sleep 2
    if kill -0 "$(cat "${PID_FILE}")" 2>/dev/null; then
        start_manager
        echo "started (pid $(cat "${PID_FILE}"))"
        return 0
    else
        echo "ERROR: hugo failed to start, see ${LOG}" >&2
        return 1
    fi
}

start_manager() {
    echo "  start_manager()" >> "${DIAG}" 2>&1
    if [ -f "${MGMT_PID_FILE}" ] && kill -0 "$(cat "${MGMT_PID_FILE}")" 2>/dev/null; then
        return 0
    fi
    if ss -tln 2>/dev/null | grep -q ":${MGMT_PORT} "; then
        echo "  manager port ${MGMT_PORT} busy" >> "${DIAG}" 2>&1
        return 0
    fi
    PY="${SRC_DIR}/manager.py"
    if [ -f "$PY" ]; then
        HUGO_BIN="${HUGO_BIN}" BLOG_DIR="${BLOG_DIR}" setsid /usr/bin/python3 "$PY" "${BLOG_DIR}" "${MGMT_PORT}" \
            >> "${MGMT_LOG}" 2>&1 &
        echo $! > "${MGMT_PID_FILE}"
    fi
}

stop() {
    echo "  stop()" >> "${DIAG}" 2>&1
    if [ -f "${PID_FILE}" ] && kill -0 "$(cat "${PID_FILE}")" 2>/dev/null; then
        kill "$(cat "${PID_FILE}")" 2>/dev/null || true
        sleep 1
    fi
    pkill -f "hugo server.*${BLOG_DIR}" 2>/dev/null || true
    rm -f "${PID_FILE}"
    # 停止管理服务
    if [ -f "${MGMT_PID_FILE}" ] && kill -0 "$(cat "${MGMT_PID_FILE}")" 2>/dev/null; then
        kill "$(cat "${MGMT_PID_FILE}")" 2>/dev/null || true
    fi
    pkill -f "manager.py.*${BLOG_DIR}" 2>/dev/null || true
    rm -f "${MGMT_PID_FILE}"
    echo "stopped"
}

status() {
    if [ -f "${PID_FILE}" ] && kill -0 "$(cat "${PID_FILE}")" 2>/dev/null; then
        echo "running (pid $(cat "${PID_FILE}"))"
        return 0
    fi
    echo "stopped"
    return 1
}

case "${1:-start}" in
    start) start ;;
    stop) stop ;;
    status) status ;;
    restart) stop; sleep 1; start ;;
    *) echo "Usage: $0 {start|stop|status|restart}"; exit 1 ;;
esac
